<title>Farmácia Hazael | Acesso ao Sistema</title>
<link rel="stylesheet" href="style.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<div class="background-decoration"></div>

<main class="container">

    <!-- PAINEL DE IDENTIDADE -->
    <section class="brand-panel">

        <div class="brand-content">

            <div class="logo">
                <div class="logo-icon">
                    <span>+</span>
                </div>

                <div class="logo-text">
                    <h1>Hazael</h1>
                    <p>FARMÁCIA</p>
                </div>
            </div>

            <div class="brand-message">

                <span class="tagline">SAÚDE • CONFIANÇA • CUIDADO</span>

                <h2>Cuidar da saúde<br>
                    é cuidar da vida.</h2>

                <p>
                    Gestão inteligente, atendimento eficiente
                    e controlo farmacêutico em um só lugar.
                </p>

            </div>

            <div class="brand-footer">
                <div class="status-dot"></div>
                Sistema de gestão farmacêutica
            </div>

        </div>

    </section>


    <!-- PAINEL DE AUTENTICAÇÃO -->
    <section class="auth-panel">

        <div class="auth-content">

            <!-- LOGIN -->
            <div id="login-form" class="form-section active">

                <div class="form-heading">

                    <span class="welcome-label">BEM-VINDO DE VOLTA</span>

                    <h2>Acesse sua conta</h2>

                    <p>Introduza os seus dados para entrar no sistema.</p>

                </div>

                <form id="formLogin">

                    <div class="input-group">

                        <label for="login-email">E-mail</label>

                        <div class="input-box">
                            <span class="input-icon">✉</span>

                            <input
                                type="email"
                                id="login-email"
                                placeholder="exemplo@email.com"
                                required
                            >
                        </div>

                    </div>


                    <div class="input-group">

                        <label for="login-password">Senha</label>

                        <div class="input-box">

                            <span class="input-icon">🔒</span>

                            <input
                                type="password"
                                id="login-password"
                                placeholder="Digite sua senha"
                                required
                            >

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword('login-password', this)">
                                Mostrar
                            </button>

                        </div>

                    </div>


                    <div class="form-options">

                        <label class="remember">
                            <input type="checkbox" id="remember">
                            <span>Manter sessão</span>
                        </label>

                        <a href="#" class="forgot-password">
                            Esqueceu a senha?
                        </a>

                    </div>


                    <button type="submit" class="submit-button">
                        Entrar no sistema
                        <span>→</span>
                    </button>

                </form>


                <div class="switch-form">

                    <p>Não possui uma conta?</p>

                    <button type="button" onclick="showRegister()">
                        Criar conta
                    </button>

                </div>

            </div>


            <!-- CADASTRO -->
            <div id="register-form" class="form-section">

                <div class="form-heading">

                    <span class="welcome-label">NOVO UTILIZADOR</span>

                    <h2>Criar uma conta</h2>

                    <p>Preencha os dados para ter acesso ao sistema.</p>

                </div>


                <form id="formRegister">

                    <div class="input-group">

                        <label for="register-name">Nome completo</label>

                        <div class="input-box">

                            <span class="input-icon">👤</span>

                            <input
                                type="text"
                                id="register-name"
                                placeholder="Digite seu nome completo"
                                required
                            >

                        </div>

                    </div>


                    <div class="input-group">

                        <label for="register-email">E-mail</label>

                        <div class="input-box">

                            <span class="input-icon">✉</span>

                            <input
                                type="email"
                                id="register-email"
                                placeholder="exemplo@email.com"
                                required
                            >

                        </div>

                    </div>


                    <div class="input-group">

                        <label for="register-password">Senha</label>

                        <div class="input-box">

                            <span class="input-icon">🔒</span>

                            <input
                                type="password"
                                id="register-password"
                                placeholder="Crie uma senha"
                                minlength="6"
                                required
                            >

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword('register-password', this)">
                                Mostrar
                            </button>

                        </div>

                    </div>


                    <div class="input-group">

                        <label for="confirm-password">Confirmar senha</label>

                        <div class="input-box">

                            <span class="input-icon">🔐</span>

                            <input
                                type="password"
                                id="confirm-password"
                                placeholder="Repita sua senha"
                                required
                            >

                        </div>

                    </div>


                    <button type="submit" class="submit-button">
                        Criar conta
                        <span>→</span>
                    </button>

                </form>


                <div class="switch-form">

                    <p>Já possui uma conta?</p>

                    <button type="button" onclick="showLogin()">
                        Entrar
                    </button>

                </div>

            </div>


            <div class="security-footer">
                <span>🛡</span>
                Ambiente de gestão • Farmácia Hazael
            </div>

        </div>

    </section>

</main>


<script src="script.js"></script>